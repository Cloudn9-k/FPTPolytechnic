USE ASM_SOF3062;
GO

-- 1. XÓA BẢNG CŨ (Theo thứ tự Con -> Cha để tránh lỗi FK)
IF OBJECT_ID('OrderDetails', 'U') IS NOT NULL DROP TABLE OrderDetails;
IF OBJECT_ID('Orders', 'U') IS NOT NULL DROP TABLE Orders;
IF OBJECT_ID('Products', 'U') IS NOT NULL DROP TABLE Products;
IF OBJECT_ID('Categories', 'U') IS NOT NULL DROP TABLE Categories;
IF OBJECT_ID('Accounts', 'U') IS NOT NULL DROP TABLE Accounts;
GO

-- 2. TẠO BẢNG MỚI (Đã thêm Long ID cho Account)

-- Bảng Accounts: Thêm id tự tăng, username thành unique
CREATE TABLE Accounts (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    username NVARCHAR(50) NOT NULL UNIQUE,
    password NVARCHAR(100) NOT NULL,
    fullname NVARCHAR(100) NOT NULL,
    email NVARCHAR(100) NOT NULL,
    photo NVARCHAR(200),
    activated BIT DEFAULT 1, 
    admin BIT DEFAULT 0 
);

-- Bảng Categories
CREATE TABLE Categories (
    id NVARCHAR(50) PRIMARY KEY,
    name NVARCHAR(100) NOT NULL
);

-- Bảng Products
CREATE TABLE Products (
    id INT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(100) NOT NULL,
    image NVARCHAR(200),
    price FLOAT NOT NULL,
    create_date DATE DEFAULT GETDATE(),
    available BIT DEFAULT 1,
    category_id NVARCHAR(50) REFERENCES Categories(id)
);

-- Bảng Orders: Sửa tham chiếu sang Account(id) thay vì username
CREATE TABLE Orders (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    account_id BIGINT REFERENCES Accounts(id), -- Link theo ID
    create_date DATETIME DEFAULT GETDATE(),
    address NVARCHAR(200) NOT NULL
);
ALTER TABLE Orders ADD status NVARCHAR(50) DEFAULT 'Pending';
